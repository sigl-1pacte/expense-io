# PostgreSQL (docker-compose)
# Rôle propriétaire : migrations et seed uniquement. Doit être superutilisateur
# (ou BYPASSRLS) : expense_notes est en FORCE ROW LEVEL SECURITY.
MIGRATION_DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io
# Rôle applicatif, créé par les migrations, soumis à la RLS (jamais superutilisateur).
DATABASE_URL=postgres://expense_app:expense_app@localhost:5433/expense_io

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=changeme-generate-a-real-secret-for-non-local-use
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true

# SonarQube local (make sonar-up). Jeton : docs/runbooks/sonarqube-analyse.md
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# OCR des reçus : nombre maximal d'analyses simultanées (entier >= 1, défaut 2)
OCR_MAX_CONCURRENCY=2
