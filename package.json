{
  "name": "expense-io-version-b",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up --envPath .env --database-url-var MIGRATION_DATABASE_URL",
    "migrate:down": "node-pg-migrate down --envPath .env --database-url-var MIGRATION_DATABASE_URL",
    "agents:sync": "node scripts/agents-sync.mjs",
    "ensure-bucket": "node scripts/ensure-bucket.mjs",
    "seed": "node scripts/seed.mjs",
    "worker": "tsx --env-file-if-exists=.env src/worker/mail-worker.ts",
    "mail:replay": "node scripts/mail-replay.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sonar": "sonar-scanner-npm",
    "sonar:bootstrap": "node --env-file-if-exists=.env scripts/sonar-bootstrap.mjs",
    "sonar:report": "node --env-file-if-exists=.env scripts/sonar-report.mjs",
    "receipts:orphans": "node scripts/receipts-orphans.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "check:sql": "node scripts/check-sql-boundaries.mjs",
    "verify": "npm run lint && npm run typecheck && npm run depcruise && npm run check:sql && npm test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sonar/scan": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
